# Python environments are OS-specific and must never be copied between hosts.
.venv/
.venv-*/
__pycache__/
*.py[cod]
*.egg-info/

# Local worker scratch/output.
.egodata-worker/
worker-output/
data/tmp/
data/logs/

# 本地运行数据(体积大且含敏感信息, 不入库)
# 项目数据集、系统状态、上传暂存、处理结果和迁移记录全部属于运行时内容。
data/

# Frontend dependencies/build cache.
web/workflow-studio/node_modules/
web/workflow-studio/dist/
web/workflow-studio/*.tsbuildinfo

# Local secrets and machine-specific settings.
.env
.env.*.local
.env.bak*
*.pem
*.key
*.p12
*.pfx
*.sqlite
*.sqlite3
*.db
*.log

# 编辑器/工具留下的备份与冲突残留文件 —— 一律不入库。
# 起因:`web/static/plyr.js.bak`(改 plyr.js 时留下的备份)被误提交进了版本库,
# 而仓库里没有任何规则拦它。改 JS 时留的 .bak 尤其容易混进来。
*.bak
*.orig
*.rej
*~

# Local model assets and scratch (large binaries, never in git).
models/
*.deb
*.zip
*.7z
*.rar
*.tar.gz
*.h5
*.hdf5
.tools/
Temp/
Test_Video/
.backups/
hdf5_demo/
s80m_stereo_camera/
head_stereo.sample.json
